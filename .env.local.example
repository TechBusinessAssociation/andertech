# Copy this file to .env.local for local dev (.env* is gitignored -- never
# commit real values). In production these are set in Vercel's dashboard
# under Project > Settings > Environment Variables, not in the repo.
# See CLAUDE.md's "Auth" section and README.md for how to get each value.

# Auth.js session encryption. Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console > OAuth 2.0 Client ID (Web application).
# Used for member sign-in -- unrelated to the Microsoft account below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Portal (Entra ID) app registration with the Files.Read.All (or
# Sites.Selected) application permission, admin-consented. Used to read
# the membership Excel workbook -- no Microsoft user signs in for this,
# it's a service-to-service read.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Identify the specific workbook file on OneDrive for Business/SharePoint.
MS_DRIVE_ID=
MS_WORKBOOK_ITEM_ID=

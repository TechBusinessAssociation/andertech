# Copy this file to .env.local for local dev (.env* is gitignored -- never
# commit real values). In production these are set in Vercel's dashboard
# under Project > Settings > Environment Variables, not in the repo.
# See CLAUDE.md's "Auth" section and README.md for how to get each value.

# Auth.js session encryption. Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console > OAuth 2.0 Client ID (Web application).
# Used for member sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Postgres. Auto-injected once you connect a Postgres database to
# this project in the Vercel dashboard (Storage tab). For local dev, run
# `vercel env pull .env.local` or copy the value from that dashboard.
POSTGRES_URL=

# Comma-separated list of emails allowed to use /admin (add/remove
# members and resource links). Keep this short -- a handful of board
# members, not the whole membership.
ADMIN_EMAILS=
